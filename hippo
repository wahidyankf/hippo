#!/bin/sh
set -eu

tool_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cache_root=${HIPPO_BUILD_CACHE:-"$tool_dir/.cache"}
goos=$(go env GOOS)
goarch=$(go env GOARCH)

# Keep the bootstrap portable across GNU/Linux and macOS without adding a
# checksum dependency to the repository.
hash_stream() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$@"
	else
		shasum -a 256 "$@"
	fi
}

modified_time() {
	stat -f '%m' "$1" 2>/dev/null || stat -c '%Y' "$1"
}

# The binary cache is content-addressed by every production Go source and its
# module graph. Changing either produces a new immutable cache generation.
source_hash=$(
	cd "$tool_dir"
	find cmd internal -type f -name '*.go' -print | LC_ALL=C sort | while IFS= read -r source_file; do hash_stream "$source_file"; done
	hash_stream go.mod go.sum 2>/dev/null || hash_stream go.mod
)
source_hash=$(printf '%s' "$source_hash" | hash_stream | awk '{print $1}')
binary_dir="$cache_root/$goos-$goarch/$source_hash"
binary="$binary_dir/hippo"
lock="$binary_dir.lock"
platform_cache="$cache_root/$goos-$goarch"
retention_lock="$platform_cache/.retention.lock"

acquire_retention_lock() {
	if mkdir "$retention_lock" 2>/dev/null; then
		printf '%s\n' "$$" >"$retention_lock/pid"
		return 0
	fi

	# Reclaim only a lock whose recorded owner no longer exists. A live or
	# malformed lock is left alone so concurrent bootstraps cannot prune it.
	if [ -f "$retention_lock/pid" ]; then
		retention_pid=$(sed -n '1p' "$retention_lock/pid" 2>/dev/null || true)
		case "$retention_pid" in
		'' | *[!0-9]*) return 1 ;;
		*)
			if kill -0 "$retention_pid" 2>/dev/null; then
				return 1
			fi
			;;
		esac
		rm -f -- "$retention_lock/candidates" "$retention_lock/pid"
		rmdir "$retention_lock" 2>/dev/null || return 1
		if mkdir "$retention_lock" 2>/dev/null; then
			printf '%s\n' "$$" >"$retention_lock/pid"
			return 0
		fi
	fi

	return 1
}

prune_cache() {
	touch "$binary_dir"
	if ! acquire_retention_lock; then
		return 0
	fi

	candidates="$retention_lock/candidates"
	trap 'rm -f -- "$retention_lock/candidates" "$retention_lock/pid"; rmdir "$retention_lock" 2>/dev/null || true' EXIT HUP INT TERM
	(
		cd "$platform_cache"
		for candidate_path in ./*; do
			[ -d "$candidate_path" ] || continue
			candidate=${candidate_path#./}
			case "$candidate" in
			'' | *[!0-9a-f]*) continue ;;
			esac
			[ "${#candidate}" -eq 64 ] || continue
			modified=$(modified_time "$candidate_path") || continue
			printf '%s %s\n' "$modified" "$candidate"
		done
	) | LC_ALL=C sort -rn >"$candidates"

	# Retain the current generation plus two recent fallbacks. Candidate names
	# are validated hashes before any recursive removal is allowed.
	recent=0
	while IFS=' ' read -r _ candidate; do
		[ -n "$candidate" ] || continue
		if [ "$candidate" = "$source_hash" ]; then
			continue
		fi
		recent=$((recent + 1))
		if [ "$recent" -gt 2 ]; then
			rm -rf -- "$platform_cache/$candidate"
		fi
	done <"$candidates"

	rm -f -- "$candidates" "$retention_lock/pid"
	rmdir "$retention_lock"
	trap - EXIT HUP INT TERM
}

if [ ! -x "$binary" ]; then
	mkdir -p "$cache_root/$goos-$goarch"
	attempts=0
	# mkdir is the cross-platform atomic lock. The bounded wait maps contention
	# to retryable exit 75 instead of starting parallel Go builds.
	while ! mkdir "$lock" 2>/dev/null; do
		if [ -f "$lock/pid" ]; then
			lock_pid=$(sed -n '1p' "$lock/pid" 2>/dev/null || true)
			case "$lock_pid" in
			'' | *[!0-9]*) ;;
			*)
				if ! kill -0 "$lock_pid" 2>/dev/null; then
					rm -f -- "$lock/pid"
					rmdir "$lock" 2>/dev/null || true
					continue
				fi
				;;
			esac
		fi
		attempts=$((attempts + 1))
		if [ "$attempts" -ge 300 ]; then
			echo "hippo bootstrap timed out waiting for its build lock" >&2
			exit 75
		fi
		sleep 1
	done
	printf '%s\n' "$$" >"$lock/pid"
	trap 'rm -f -- "$lock/pid"; rmdir "$lock" 2>/dev/null || true' EXIT HUP INT TERM
	if [ ! -x "$binary" ]; then
		mkdir -p "$binary_dir"
		temporary="$binary.tmp.$$"
		# Build with bounded compiler parallelism, then atomically publish the
		# executable so another process never observes a partial binary.
		(
			cd "$tool_dir"
			GOMAXPROCS=2 go build -p=1 -trimpath -o "$temporary" ./cmd/hippo
		)
		chmod 700 "$temporary"
		mv "$temporary" "$binary"
	fi
	rm -f -- "$lock/pid"
	rmdir "$lock"
	trap - EXIT HUP INT TERM
fi

prune_cache
# A consumer may override configuration explicitly; otherwise the optional
# repository-local file is discovered without making it authoritative.
HIPPO_DEFAULT_CONFIG=${HIPPO_DEFAULT_CONFIG:-"$tool_dir/hippo.local.json"}
export HIPPO_DEFAULT_CONFIG
exec "$binary" "$@"
